# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# Use the "publishable key" (Supabase's current name for this key - some
# dashboards still label it "anon key", same value either way).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Service role key - server-side only, NEVER expose to the browser or commit it.
# Used by API route handlers to grade exams and write attempt data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build candidate assessment links (e.g. https://assess.yourcompany.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only. The Supabase Auth user id (uuid) that is allowed into /admin.
# Get it from Supabase Dashboard -> Authentication -> Users, or from the output of
# `npm run create-admin`. Never prefix this with NEXT_PUBLIC_ - it must not reach the browser.
ADMIN_UID=00000000-0000-0000-0000-000000000000
