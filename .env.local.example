# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - server-side only, NEVER expose to the browser or commit it.
# Used by API route handlers to grade exams and write attempt data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Base URL of this app, used to build candidate assessment links (e.g. https://assess.yourcompany.com)
NEXT_PUBLIC_APP_URL=http://localhost:3000
